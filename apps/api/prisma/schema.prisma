generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  owner
  builder
  client
}

enum ChangeStatus {
  proposed
  applied
  rejected
  undone
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  /// Numero WhatsApp in formato internazionale, solo cifre (es. 393331234567)
  whatsapp     String?      @unique
  /// Attività che il numero WhatsApp aggiorna (per chi ne gestisce più di una)
  whatsappBusinessId String?
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  changes      Change[]
  whatsappLinks WhatsAppLink[]
}

/// Codice monouso per collegare un numero WhatsApp: il titolare lo invia dal suo telefono,
/// così il numero collegato è sicuramente il suo.
model WhatsAppLink {
  code       String   @id
  userId     String
  businessId String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// L'attività: il centro del modello. Il sito è solo uno dei modi di mostrarla.
model Business {
  id           String          @id @default(cuid())
  slug         String          @unique
  name         String
  category     String          @default("")
  description  String          @default("")
  phone        String          @default("")
  email        String          @default("")
  address      String          @default("")
  /// Foto di copertina (URL Cloudinary)
  coverUrl     String?
  /// Logo dell'attività (URL Cloudinary)
  logoUrl      String?
  timezone     String          @default("Europe/Rome")
  /// Colori e font scelti dal costruttore
  theme        Json            @default("{}")
  createdAt    DateTime        @default(now())
  memberships  Membership[]
  openingHours OpeningHours[]
  specialHours SpecialHours[]
  catalog      CatalogItem[]
  photos       Photo[]
  posts        Post[]
  pages        Page[]
  changes      Change[]
}

model Membership {
  userId     String
  businessId String
  role       Role
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@id([userId, businessId])
}

model OpeningHours {
  id         String   @id @default(cuid())
  businessId String
  /// 1 = lunedì ... 7 = domenica
  weekday    Int
  opens      String
  closes     String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model SpecialHours {
  id         String   @id @default(cuid())
  businessId String
  /// YYYY-MM-DD
  date       String
  closed     Boolean
  opens      String?
  closes     String?
  note       String?
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, date])
}

model CatalogItem {
  id          String   @id
  businessId  String
  position    Int
  section     String
  name        String
  description String   @default("")
  price       Float?
  available   Boolean  @default(true)
  /// Foto della voce (URL Cloudinary)
  image       String?
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

/// Galleria di foto dell'attività, nell'ordine in cui si mostra.
model Photo {
  id         String   @id
  businessId String
  position   Int
  url        String
  caption    String   @default("")
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Post {
  id         String   @id
  businessId String
  position   Int
  kind       String
  title      String
  body       String
  startsAt   String?
  endsAt     String?
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

/// Struttura delle pagine: blocchi che leggono i dati dell'attività.
model Page {
  id         String   @id @default(cuid())
  businessId String
  slug       String
  title      String
  layout     Json
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([businessId, slug])
}

/// Ogni modifica ai dati passa da qui: proposta, anteprima, conferma, annullamento.
model Change {
  id         String       @id @default(cuid())
  businessId String
  authorId   String
  /// chat | form | whatsapp
  source     String
  message    String?
  ops        Json
  summary    Json
  before     Json
  after      Json
  status     ChangeStatus @default(proposed)
  createdAt  DateTime     @default(now())
  appliedAt  DateTime?
  business   Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  author     User         @relation(fields: [authorId], references: [id])

  @@index([businessId, createdAt])
}

/// Inbox persistente. I vecchi record senza payload restano deduplicati.
model InboundMessage {
  id        String   @id
  createdAt DateTime @default(now())
  sequence  BigInt   @default(autoincrement())
  sender    String?
  payload   Json?
  processedAt DateTime?
  attempts  Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lastError String?

  @@index([processedAt, nextAttemptAt])
  @@index([sender, sequence])
}

/// Risposte salvate insieme agli effetti del messaggio; inviate con retry.
model WhatsAppOutbound {
  id        String   @id @default(cuid())
  sequence  BigInt   @unique @default(autoincrement())
  recipient String
  payload   Json
  createdAt DateTime @default(now())
  sentAt    DateTime?
  attempts  Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lastError String?

  @@index([sentAt, nextAttemptAt])
  @@index([recipient, sequence])
}
